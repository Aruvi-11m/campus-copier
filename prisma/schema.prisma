// Prisma Schema for CampusCopier (PostgreSQL Production + Object Storage)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())

  assignedOrders Order[]
}

model ServicePrice {
  id          String   @id @default(uuid())
  serviceKey  String   @unique
  name        String
  unit        String
  pricePaise  Int
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model UpiAccount {
  id          String   @id // "account_1" | "account_2"
  displayName String   // e.g. "Barathwaj", "Thamizaruvi"
  upiId       String   // e.g. "barathwaj@upi"
  qrCodeData  String?  // Optional uploaded custom QR image override
  isEnabled   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ReadyPrint {
  id               String   @id @default(uuid())
  title            String
  category         String?
  description      String?
  
  storageKey       String   // Persistent Object Storage / Vercel Blob URL
  fileName         String
  mimeType         String
  fileSize         Int
  pageCount        Int

  defaultPrintMode String   @default("BW_SINGLE")
  defaultBinding   String   @default("NONE")
  defaultCopies    Int      @default(1)

  isPublished      Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdByAdminId String?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems       OrderItem[]
}

model FileAsset {
  id         String   @id @default(uuid())
  storageKey String   // Persistent Object Storage / Vercel Blob URL
  fileName   String
  mimeType   String
  fileSize   Int
  createdAt  DateTime @default(now())
}

model Order {
  id                  String      @id // Custom Order ID e.g., CC-1001
  customerName        String
  customerMobile      String
  specialInstructions String?
  pickupMethod        String      @default("College Pickup")
  totalAmountPaise    Int
  paymentMethod       String      // "UPI" | "CASH"
  paymentStatus       String      @default("UNPAID") // "UNPAID" | "PAYMENT_SUBMITTED" | "PAID"
  
  // Historical UPI snapshot
  upiRecipientName    String?     // e.g. "Barathwaj"
  upiIdSnap           String?     // e.g. "barathwaj@upi"

  orderStatus         String      @default("NEW") // "NEW" | "ACCEPTED" | "PRINTING" | "COMPLETED"
  
  assignedAdminId     String?
  assignedAdmin       Admin?      @relation(fields: [assignedAdminId], references: [id])
  
  acceptedAt          DateTime?
  printingStartedAt   DateTime?
  completedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items               OrderItem[]
  paymentProof        PaymentProof?
}

model OrderItem {
  id                String      @id @default(uuid())
  orderId           String
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  sourceType        String      @default("CUSTOMER_UPLOAD") // "CUSTOMER_UPLOAD" | "READY_PRINT"
  readyPrintId      String?
  readyPrint        ReadyPrint? @relation(fields: [readyPrintId], references: [id])
  documentTitle     String?     // Historical document title snapshot
  
  fileName          String
  fileData          String?     // Backwards compatible optional data URL
  storageKey        String?     // Persistent Object Storage / Vercel Blob URL
  mimeType          String
  fileSize          Int
  
  printMode         String   // "BW_SINGLE" | "BW_DOUBLE" | "BW_4UP" | "COLOR_SINGLE"
  pageCount         Int
  physicalSheets    Int
  copies            Int
  bindingOption     String   // "NONE" | "SOFT" | "SPIRAL"
  
  pricePerUnitPaise Int
  bindingPricePaise Int
  subtotalPaise     Int
}

model PaymentProof {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  fileData   String?  // Backwards compatible optional data URL
  storageKey String?  // Persistent Object Storage / Vercel Blob URL
  uploadedAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
